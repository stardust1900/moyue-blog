---
import type { Post } from '../utils/posts';
import { postSlug, estimateReadingTime } from '../utils/posts';
import { withBase } from '../utils/url';
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, category, tags, date, description, coverEmoji } = post.data;
const href = withBase('/posts/' + postSlug(post) + '/');
const readingTime = estimateReadingTime(post.body);
---

<a
  href={href}
  class="group block h-full rounded-2xl border border-border bg-card overflow-hidden hover:shadow-lg transition-shadow"
>
  <div class="flex items-center justify-center h-40 bg-gradient-to-br from-muted/50 to-muted text-6xl group-hover:scale-105 transition-transform duration-500">
    {coverEmoji}
  </div>
  <div class="p-5 space-y-3">
    <div class="flex items-center gap-3 text-xs text-muted-foreground">
      <span class="font-medium text-primary">{category}</span>
      <span class="flex items-center gap-1">
        <Icon name="calendar" size={12} />
        <FormattedDate date={date} />
      </span>
    </div>
    <h3 class="font-bold text-lg leading-snug line-clamp-2 group-hover:text-primary transition-colors">
      {title}
    </h3>
    <p class="text-sm text-muted-foreground line-clamp-3 leading-relaxed">{description}</p>
    <div class="flex items-center justify-between pt-2">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs font-normal px-2 py-0.5 rounded-full bg-secondary text-secondary-foreground">
            {tag}
          </span>
        ))}
      </div>
      <span class="flex items-center gap-1 text-xs text-muted-foreground whitespace-nowrap">
        <Icon name="clock" size={12} />
        {readingTime}分钟
      </span>
    </div>
  </div>
</a>
