interface Props {
  name: keyof typeof icons | string;
  class?: string;
  size?: number;
}
const { name, class: className = '', size = 24 } = Astro.props;
const inner = icons[name] ?? '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={inner}
/>
