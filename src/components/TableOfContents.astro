---
import Icon from './Icon.astro';
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  items.length > 0 && (
    <nav class="space-y-2">
      <div class="flex items-center gap-2 mb-3 text-sm font-semibold text-foreground">
        <Icon name="list-tree" size={16} />
        目录
      </div>
      <ul class="space-y-1 border-l border-border">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc={h.slug}
              class:list={[
                'block w-full text-left py-1 text-sm transition-colors hover:text-primary border-l-2 border-transparent -ml-px pl-3 text-muted-foreground',
                h.depth === 3 && 'pl-6',
                h.depth === 4 && 'pl-9',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-toc]'));
  if (links.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((l) => {
              const active = l.dataset.toc === id;
              l.classList.toggle('text-primary', active);
              l.classList.toggle('font-medium', active);
              l.classList.toggle('border-primary', active);
            });
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    links.forEach((l) => {
      const el = document.getElementById(l.dataset.toc!);
      if (el) observer.observe(el);
      l.addEventListener('click', (e) => {
        e.preventDefault();
        const el = document.getElementById(l.dataset.toc!);
        if (el) {
          const top = el.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top, behavior: 'smooth' });
          history.replaceState(null, '', '#' + l.dataset.toc);
        }
      });
    });
  }
</script>
