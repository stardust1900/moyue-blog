---
import type { Post } from '../utils/posts';
import { postSlug, estimateReadingTime } from '../utils/posts';
import { withBase } from '../utils/url';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
  related: Post[];
  // notebook 文章：已渲染的 HTML 正文（由 notebook-loader 生成），用 set:html 注入
  bodyHtml?: string;
}
const { post, headings, related, bodyHtml } = Astro.props;
const { title, category, tags, date, description, coverEmoji } = post.data;
const readingTime = estimateReadingTime(post.body);
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <div class="border-b border-border bg-gradient-to-b from-muted/30 to-background">
    <div class="container mx-auto px-4 py-12 md:py-16">
      <div class="max-w-3xl mx-auto">
        <a href={withBase('/')} class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
          <Icon name="arrow-left" size={16} /> 返回首页
        </a>
        <div class="flex items-center gap-3 text-sm mb-4">
          <span class="px-3 py-1 rounded-full bg-primary/10 text-primary font-medium">{category}</span>
          <span class="flex items-center gap-1 text-muted-foreground">
            <Icon name="calendar" size={14} /> <FormattedDate date={date} />
          </span>
          <span class="flex items-center gap-1 text-muted-foreground">
            <Icon name="clock" size={14} /> {readingTime} 分钟阅读
          </span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">{title}</h1>
        <p class="text-lg text-muted-foreground leading-relaxed mb-6">{description}</p>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={withBase('/tags/' + encodeURIComponent(tag) + '/')} class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-secondary text-secondary-foreground text-sm hover:bg-primary hover:text-primary-foreground transition-colors">
              <Icon name="tag" size={12} /> {tag}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Content + TOC -->
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-12 max-w-5xl mx-auto">
      <div class="min-w-0">
        <div class="text-5xl mb-8 text-center">{coverEmoji}</div>
        <article class="prose-blog notebook-content">
          {bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />}
        </article>

        <div class="mt-12 pt-8 border-t border-border flex items-center justify-between">
          <a href={withBase('/')} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors">
            <Icon name="arrow-left" size={16} /> 返回首页
          </a>
          <a href="#top" class="text-sm text-muted-foreground hover:text-foreground transition-colors">回到顶部 ↑</a>
        </div>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="container mx-auto px-4 py-12 border-t border-border">
        <div class="flex items-center gap-2 mb-8">
          <div class="w-1 h-6 rounded-full bg-primary" />
          <h2 class="text-xl font-bold">相关文章</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((rel) => (
            <ArticleCard post={rel} />
          ))}
        </div>
      </section>
    )
  }

  <div class="container mx-auto px-4 max-w-5xl">
    <Giscus />
  </div>

  <script>
    import { initArticleHighlight } from '../utils/article-search';
    initArticleHighlight();
  </script>

  <!-- Mermaid：把 ```mermaid 代码块渲染为 SVG 图；附带图片/Mermaid 点击放大查看 -->
  <script>
    import mermaid from 'mermaid';
    import { initImageZoom } from '../utils/image-zoom';
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
      // 与博客字体栈一致，避免用 fallback 字体测量导致节点文字被裁
      fontFamily:
        '"Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif',
      // 关闭 foreignObject 渲染：节点文字改用原生 <text>，避免被 foreignObject 的 overflow:hidden 硬裁
      htmlLabels: false,
      flowchart: { useMaxWidth: true },
    });
    async function renderMermaid() {
      // 等待 web 字体加载完成后再测量渲染，否则节点宽度按 fallback 字体计算会截断文字
      try {
        await document.fonts.ready;
      } catch {
        /* 环境不支持时直接渲染 */
      }
      const codes = document.querySelectorAll('pre[data-language="mermaid"] code');
      for (const code of codes) {
        const text = code.textContent ?? '';
        if (!text.trim()) continue;
        const pre = code.closest('pre');
        try {
          const id = 'mermaid-' + Math.random().toString(36).slice(2);
          const { svg } = await mermaid.render(id, text);
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.innerHTML = svg;
          if (pre?.parentNode) pre.replaceWith(div);
          else code.replaceWith(div);
        } catch (err) {
          console.error('[mermaid] render failed:', err);
        }
      }
    }
    initImageZoom();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  </script>
</BaseLayout>
