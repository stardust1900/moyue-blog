---
import { SITE } from '../consts';
import { withBase } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面未找到" description="页面不存在">
  <div class="container mx-auto px-4 min-h-[60vh] flex items-center justify-center">
    <div class="text-center space-y-4">
      <div class="text-6xl">📭</div>
      <h1 class="text-2xl font-bold">页面未找到</h1>
      <p class="text-muted-foreground">你访问的页面可能已被移动或删除</p>
      <a href={withBase('/')} class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-primary-foreground text-sm">
        <Icon name="arrow-left" size={16} /> 返回首页
      </a>
    </div>
  </div>
</BaseLayout>
