---
import { getSortedPosts } from '../../utils/posts';
import { POSTS_PER_PAGE } from '../../consts';
import { withBase } from '../../utils/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostTable from '../../components/PostTable.astro';
import SearchBar from '../../components/SearchBar.astro';
import Pagination from '../../components/Pagination.astro';
import { initPostSearch } from '../../utils/post-search';

const all = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(all.length / POSTS_PER_PAGE));
const pagePosts = all.slice(0, POSTS_PER_PAGE);
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
---

<BaseLayout title="文章列表">
  <section class="container mx-auto px-4 py-12">
    <div class="mb-8 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-1 h-6 rounded-full bg-primary" />
        <h1 class="text-2xl font-bold">文章列表</h1>
      </div>
      <span class="text-sm text-muted-foreground">共 {all.length} 篇</span>
    </div>

    <div class="mb-6">
      <SearchBar value={q} />
    </div>

    <PostTable posts={pagePosts} />

    <Pagination
      current={1}
      last={totalPages}
      prev={null}
      next={totalPages > 1 ? withBase('/posts/page/2') : null}
      base="/posts/page"
      query={q ? `q=${encodeURIComponent(q)}` : ''}
    />
  </section>
</BaseLayout>

<script>
  import { initPostSearch } from '../../utils/post-search';
  initPostSearch();
</script>
